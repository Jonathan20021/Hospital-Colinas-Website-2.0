.idea/

# Logs
*.log
php-server.err.log
php-server.out.log

# Local env / secrets
.env
.env.local
*.env
includes/config.local.php

# Large source video (use videohospital-web.mp4 instead; 187MB exceeds GitHub limit)
assets/site/assets/videohospital-BsNC9-JF.mp4
assets/source/videohospital-BsNC9-JF.mp4

# Temp / build
/tmp/
*.tmp
*.bak
# ...y los respaldos con sufijo (app.css.bak.redesign.20260531012503): el
# patron de arriba solo cubre los que TERMINAN en .bak. Uno de esos se colo
# al repo y acabo publicado en produccion (189 KB descargables).
*.bak.*
*~

# Node dependencies
node_modules/

.claude/settings.local.json

# cPanel deploy marker (escrito por .cpanel.yml; no es código fuente)
.deployed-at

# Runtime storage (rate-limit buckets, caches) — son archivos generados,
# no código fuente. Si quedan tracked, git los marca como modificados en
# cada request y cPanel bloquea el Deploy HEAD Commit.
/storage/ai-rate/
/storage/cache/
/storage/track-rate/

# Código desplegado DIRECTO en JENOFONTE (servidor interno) + scripts de prueba.
# No va a GitHub/cPanel; se conserva solo la documentación de despliegue.
/deploy/estudios/jenofonte/
/storage/agendar-rate/
